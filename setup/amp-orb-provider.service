[Unit]
Description=Amp orb provider (Incus)
After=network-online.target incus.service
Wants=network-online.target

[Service]
User=debian
SupplementaryGroups=incus-admin
EnvironmentFile=/etc/amp-orb-provider.env
ExecStart=/usr/local/bin/amp orb provider /opt/amp-orbs/dispatch.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
